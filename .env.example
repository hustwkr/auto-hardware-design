# Backend Server Configuration
# Copy this file to .env and fill in your values
# Usage: cd backend && node server.js (reads from ../.env via dotenv, or set env vars directly)

# Admin password for /admin panel (REQUIRED - at least 12 chars, no common passwords)
ADMIN_PASSWORD=change_me_now

# Server port (default: 8080)
PORT=8080

# Token secret (auto-generated and persisted to backend/.token_secret if not set)
# TOKEN_SECRET=your-random-secret-here

# SMTP settings for feedback email notifications (all optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password
# SMTP_FROM=your-email@example.com
# SMTP_TO=your-email@example.com
